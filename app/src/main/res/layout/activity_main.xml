<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#202124"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">

            <TextView android:id="@+id/btnBack" style="@style/TbBtn" android:text="Back" />
            <TextView android:id="@+id/btnFwd" style="@style/TbBtn" android:text="Fwd" />
            <TextView android:id="@+id/btnReload" style="@style/TbBtn" android:text="Reload" />
            <TextView android:id="@+id/btnHome" style="@style/TbBtn" android:text="Home" />

            <EditText
                android:id="@+id/urlBar"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:background="#303134"
                android:hint="Search or enter address"
                android:textColor="#FFFFFF"
                android:textColorHint="#9AA0A6"
                android:textSize="15sp"
                android:singleLine="true"
                android:selectAllOnFocus="true"
                android:inputType="textUri"
                android:imeOptions="actionGo" />

            <TextView android:id="@+id/btnTabs" style="@style/TbBtn" android:text="Tabs (1)" />
            <TextView android:id="@+id/btnFavs" style="@style/TbBtn" android:text="Favorites" />
            <TextView android:id="@+id/btnFav" style="@style/TbBtn" android:text="+ Fav" />
            <TextView android:id="@+id/btnShield" style="@style/TbBtn" android:text="Shield" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/webHolder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <com.tvbrowser.CursorView
        android:id="@+id/cursor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</FrameLayout>
